{
  "name": "todo-v3-typescript",
  "private": true,
  "version": "3.0.0",
  "description": "Todo 列表 V3.0 - TypeScript 重构 + 单元测试",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --outfile=dist/main.js --format=esm",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
